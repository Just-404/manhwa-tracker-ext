{
  "manifest_version": 2,
  "name": "Manhwa Tracker",
  "version": "2.0.0",
  "description": "A Firefox extension to track your reading manhwa progress.",

  "browser_specific_settings": {
    "gecko": {
      "id": "{3456e31e-e73a-4d4a-8b28-fd797357dff9}",
      "strict_min_version": "78.0"
    }
  },

  "browser_action": {
    "default_popup": "index.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "background": {
    "scripts": ["background.js"],
    "persistent": true
  },

  "permissions": ["activeTab", "tabs", "https://graphql.anilist.co/", "https://api.mangadex.org/", "https://uploads.mangadex.org/"],
  "content_security_policy": "script-src 'self'; object-src 'self'; connect-src https://graphql.anilist.co https://api.mangadex.org https://uploads.mangadex.org"
}
